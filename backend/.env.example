## Platform (super admin) login throttle.
## After SUPER_ADMIN_MAX_LOGIN_ATTEMPTS wrong passwords the account is locked
## for SUPER_ADMIN_LOCKOUT_MINUTES. A correct password clears the counter.
SUPER_ADMIN_MAX_LOGIN_ATTEMPTS=5
SUPER_ADMIN_LOCKOUT_MINUTES=15

## Bootstrap credentials, read by the seeders on a FRESH database so it can be
## signed into at all. Change them before exposing anything.
## Platform admin (super_admin_users) -- seeded by platform_admin_seeder.
PLATFORM_ADMIN_EMAIL=platform@admin.local
PLATFORM_ADMIN_PASSWORD=Platform@123
PLATFORM_ADMIN_FIRST_NAME=Platform
PLATFORM_ADMIN_LAST_NAME=Admin
## Demo tenant Owner (tenant users) -- seeded by demo_tenant_owner_seeder.
## Demo tenants only: a platform-created tenant's administrator sets their own
## password on the invitation accept page, so no seeder writes an account there.
DEMO_TENANT_OWNER_EMAIL=owner@demo.local
DEMO_TENANT_OWNER_PASSWORD=Owner@123
DEMO_TENANT_OWNER_FIRST_NAME=Demo
DEMO_TENANT_OWNER_LAST_NAME=Owner

## JWT
JWT_SECRET_KEY=zmrJjazLkkcz5NLXyw57WBHVScdfjDod
JWT_ALGO=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=7

## Public origin this deployment is reached at.
